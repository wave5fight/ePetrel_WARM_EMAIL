EPETREL_SESSION_SECRET="change-this-local-session-secret"
EPETREL_DB_PATH="database/storage.db"

MAIL_FROM_NAME="MutualWarm"

# Warm OpenAI-compatible LLM. You can also save these from Configuration.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# MutualWarm local worker and pacing safeguards.
WARM_WORKER_ENABLED=1
WARM_WORKER_INTERVAL_SECONDS=300
WARM_TASK_CLAIM_LIMIT=1
WARM_SEND_MIN_GAP_SECONDS=180
WARM_SEND_MAX_GAP_SECONDS=480
WARM_PROBE_SCAN_TIMEOUT_SECONDS=90
WARM_PROBE_SCAN_MIN_INTERVAL_SECONDS=7
WARM_PROBE_SCAN_MAX_INTERVAL_SECONDS=15
WARM_PROBE_RESCAN_TIMEOUT_SECONDS=45
WARM_PROBE_REPLY_MIN_DELAY_SECONDS=12
WARM_PROBE_REPLY_MAX_DELAY_SECONDS=45
WARM_MAILBOX_OFFLINE_WARN_SEC=3600
WARM_MAILBOX_STALE_SEC=259200

# Optional local warm policy defaults before ePetrel scheduler policy is received.
WARM_LOCAL_TIMEZONE="Asia/Shanghai"
WARM_SCAN_SOFT_TIMEOUT_HOURS=24
WARM_SCAN_HARD_TIMEOUT_HOURS=48
WARM_REPLY_MIN_DELAY_HOURS=2
WARM_REPLY_HARD_TIMEOUT_HOURS=48
WARM_SLEEP_START_HOUR=22
WARM_SLEEP_END_HOUR=7
WARM_AVOID_WEEKENDS=1
WARM_ALLOWED_EMAIL_DOMAINS="gmail.com,googlemail.com"
